[Unit]
Description=Read a restricted site deployment signal for Uptime Kuma
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -I /usr/local/lib/uptime-kuma-site-work/poll.py --config /var/lib/uptime-kuma-site-watch/config.json
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=192.0.2.10/32
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE
ReadOnlyPaths=/var/lib/uptime-kuma-site-watch
ReadWritePaths=/srv/uptime-kuma-pilot/data
MemoryMax=48M
MemorySwapMax=0
LimitCORE=0
TasksMax=16
TimeoutStartSec=12
