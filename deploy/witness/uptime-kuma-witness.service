[Unit]
Description=Independent witness for the owned Uptime Kuma installation
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
DynamicUser=yes
StateDirectory=uptime-kuma-witness
StateDirectoryMode=0700
LoadCredentialEncrypted=witness-config:/srv/uptime-kuma-witness/witness-config.cred
ExecStart=/usr/bin/python3 -I /srv/uptime-kuma-witness/witness.py
Restart=on-failure
RestartSec=15
RestartPreventExitStatus=2
TimeoutStopSec=45
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
CPUQuota=5%
MemoryMax=96M
TasksMax=16

[Install]
WantedBy=multi-user.target
